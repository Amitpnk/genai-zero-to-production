.0" y="90" as="sourcePoint"/><mxPoint x="396.0" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;kept: 90.3%&lt;/b&gt;&lt;br&gt;4 tokens can be picked" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;fontColor=#A4500C;align=right;" vertex="1" parent="1"><mxGeometry x="166.0" y="92" width="220" height="40" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;dropped&lt;/b&gt;&lt;br&gt;never picked, however lucky" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;fontColor=#4A5568;align=left;" vertex="1" parent="1"><mxGeometry x="406.0" y="92" width="260" height="40" as="geometry"/></mxCell><mxCell id="c35" value="" style="endArrow=none;html=1;strokeColor=#4A5568;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="360" as="sourcePoint"/><mxPoint x="920" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="At T = 1.0 (temperature_dial.py). Top-k is the simpler version: keep a fixed number of tokens, e.g. top_k = 40." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="920" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep05-4" name="4 · How an answer ends"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="470" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Three ways generation stops" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Natural end&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;font-family:Courier New"&gt;model emits its end token&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="86" as="geometry"/></mxCell><mxCell id="c3" value='&lt;span style="font-family:Courier New"&gt;Photosynthesis is how plants turn light into food.&lt;/span&gt; &lt;b style="color:#A4500C"&gt;&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="640" height="86" as="geometry"/></mxCell><mxCell id="c4" value='finish reason:&lt;br&gt;&lt;b style="font-family:Courier New"&gt;stop / STOP&lt;/b&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="108" width="200" height="30" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Max tokens&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;font-family:Courier New"&gt;num_predict = 12&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="86" as="geometry"/></mxCell><mxCell id="c6" value='&lt;span style="font-family:Courier New"&gt;Photosynthesis is the process by which plants and some other&lt;/span&gt; &lt;b style="color:#A4500C"&gt;✂&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="640" height="86" as="geometry"/></mxCell><mxCell id="c7" value='finish reason:&lt;br&gt;&lt;b style="font-family:Courier New"&gt;length / MAX_TOKENS&lt;/b&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="218" width="200" height="30" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Stop sequence&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;font-family:Courier New"&gt;stop = ["\n3."]&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="86" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-family:Courier New"&gt;1. Apple  2. Banana&lt;/span&gt; &lt;b style="color:#A4500C"&gt;■&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="640" height="86" as="geometry"/></mxCell><mxCell id="c10" value='finish reason:&lt;br&gt;&lt;b style="font-family:Courier New"&gt;stop&lt;/b&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="328" width="200" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Ollama shows done_reason; Gemini finish_reason; OpenAI finish_reason; Claude stop_reason. Always check it: a “length” stop means the answer is incomplete." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1080" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>