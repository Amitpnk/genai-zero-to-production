<mxfile host="genai-zero-to-production" type="device"><diagram id="ep05-1" name="1 · From scores to a token"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="330" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="How the next token is chosen, and where each parameter acts" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Model scores&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;a probability for&lt;br&gt;every token&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="100" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Temperature&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;sharpen or flatten&lt;br&gt;the distribution&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="265" y="100" width="180" height="100" as="geometry"/></mxCell><mxCell id="c4" value="temperature" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;fontColor=#A4500C;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="265" y="212" width="180" height="24" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Top-p / top-k&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;cut off the&lt;br&gt;unlikely tail&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994