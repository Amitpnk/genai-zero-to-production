<mxfile host="genai-zero-to-production" type="device"><diagram id="ep07-1" name="1 · Anatomy of an API call"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="440" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Every LLM API call: you send a request, you get a response" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='REQUEST&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"model": "...",&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;lt;- from .env&lt;br&gt;&amp;nbsp;&amp;nbsp;"system": "You are...",&amp;nbsp;&amp;nbsp;&amp;lt;- role + rules&lt;br&gt;&amp;nbsp;&amp;nbsp;"messages": [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{"role": "user",&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; "content": "..."}&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;"max_tokens": 500,&lt;br&gt;&amp;nbsp;&amp;nbsp;"temperature": 0.3&lt;br&gt;}' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#F5F2EA;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="430" height="290" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;LLM API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;+ your API key&lt;br&gt;(from .env)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="175" width="140" height="100" as="geometry"/></mxCell><mxCell id="c4" value='RESPONSE&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"content": "A context window&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is ...",&lt;br&gt;&amp;nbsp;&amp;nbsp;"finish_reason": "stop",&lt;br&gt;&amp;nbsp;&amp;nbsp;"usage": {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"input_tokens": 31,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"output_tokens": 30&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#F5F2EA;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="710" y="80" width="410" height="290" as="geometry"/></mxCell><mxCell id="c5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="Field names differ by provider (system vs instructions, content vs text, stop_reason vs finish_reason), but the shape is the same. Real numbers from first_call.py." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="1080" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep07-2" name="2 · Three roles"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="430" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Three roles in every conversation" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-family:Courier New;font-size:16px"&gt;system&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#D8E4F8;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="85" as="geometry"/></mxCell><mxCell id="c3" value="Sets the role and the rules, once" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="300" height="85" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i&gt;“You are a support agent for an online bookshop. Be brief. Always ask for the order number.”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="570" height="85" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-family:Courier New;font-size:16px"&gt;user&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="170" height="85" as="geometry"/></mxCell><mxCell id="c6" value="What the person (or your app) says" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="185" width="300" height="85" as="geometry"/></mxCell><mxCell id="c7" value="&lt;i&gt;“My order arrived damaged. What should I do?”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="185" width="570" height="85" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-family:Courier New;font-size:16px"&gt;assistant&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="170" height="85" as="geometry"/></mxCell><mxCell id="c9" value='What the model said before (Gemini calls it "model")' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="290" width="300" height="85" as="geometry"/></mxCell><mxCell id="c10" value="&lt;i&gt;“I'm so sorry! Could you share your order number?”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="570" height="85" as="geometry"/></mxCell><mxCell id="c11" value="Messages alternate user → assistant → user… The system prompt is sent with every request." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="1080" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep07-3" name="3 · The API is stateless"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="470" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The API has no memory: your app sends the whole conversation every turn" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Turn 1: request sends 1 message&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="340" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 1  ← new' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;strokeColor=#A4500C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="300" height="42" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Turn 2: request sends 3 messages&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="78" width="340" height="30" as="geometry"/></mxCell><mxCell id="c5" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 1' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="118" width="300" height="42" as="geometry"/></mxCell><mxCell id="c6" value='&lt;span style="font-family:Courier New"&gt;assistant&lt;/span&gt; 1' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="170" width="300" height="42" as="geometry"/></mxCell><mxCell id="c7" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 2  ← new' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;strokeColor=#A4500C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="222" width="300" height="42" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Turn 3: request sends 5 messages&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="78" width="340" height="30" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 1' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="118" width="300" height="42" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="font-family:Courier New"&gt;assistant&lt;/span&gt; 1' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="170" width="300" height="42" as="geometry"/></mxCell><mxCell id="c11" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 2' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="222" width="300" height="42" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-family:Courier New"&gt;assistant&lt;/span&gt; 2' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="274" width="300" height="42" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-family:Courier New"&gt;user&lt;/span&gt; 3  ← new' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;strokeColor=#A4500C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="326" width="300" height="42" as="geometry"/></mxCell><mxCell id="c14" value="Leave the history out and the model forgets: in chat.py --demo it answered “I don't have access to personal information” instead of “Your name is Asha”. Long histories cost more every turn (Episode 4), so trim or summarise them." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1080" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep07-4" name="4 · Streaming"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="380" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Streaming: same answer, first words much sooner" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Without streaming&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="600" height="26" as="geometry"/></mxCell><mxCell id="c3" value="waiting… nothing on screen" style="rounded=0;html=1;fillColor=#E3E0D9;strokeColor=none;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="864.5" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;all text&lt;/b&gt;" style="rounded=0;html=1;fillColor=#B9C2D0;strokeColor=none;fontColor=#0E1726;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="904.5" y="110" width="70" height="50" as="geometry"/></mxCell><mxCell id="c5" value="whole answer appears at 9.1 s" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=12;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="1060" height="22" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;With streaming&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="600" height="26" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;html=1;fillColor=#E3E0D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="209.00000000000003" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;words appear as they're generated…&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2994A;strokeColor=none;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="249.00000000000003" y="230" width="569.9999999999999" height="50" as="geometry"/></mxCell><mxCell id="c9" value="first words at 2.2 s · finished at 8.2 s" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=12;fontColor=#A4500C;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="1060" height="22" as="geometry"/></mxCell><mxCell id="c10" value="Real timings from streaming.py (gemma3:1b, local, model warmed up first). Streaming doesn't make the model faster; it lets the user start reading straight away." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1080" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>