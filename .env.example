# Copy to .env and paste real values:  cp .env.example .env
# This file is committed. Names and fake values only, never real keys.

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=model-id-from-anthropic-docs

# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=model-id-from-openai-docs

# Google Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AWS Bedrock
AWS_PROFILE=genai-course
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=model-id-from-bedrock-catalog

# Local models with Ollama (Episode 3+): ollama pull gemma3:1b
OLLAMA_MODEL=gemma3:1b
