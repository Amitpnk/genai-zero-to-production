<mxfile host="genai-zero-to-production" type="device"><diagram id="ep06-1" name="1 · Closed vs open-weight"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="470" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Closed vs open-weight models" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Closed (API-only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="500" height="46" as="geometry"/></mxCell><mxCell id="c3" value="Open-weight (you can download it)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#A4500C;strokeColor=#A4500C;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="500" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#4A5568;font-size:12px&quot;&gt;How you use it&lt;/span&gt;&lt;br&gt;Call the provider's API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="500" height="62" as="geometry"/></mxCell><mxCell id="c5" value='&lt;span style="color:#4A5568;font-size:12px"&gt;How you use it&lt;/span&gt;&lt;br&gt;Download the weights; run anywhere' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="500" height="62" as="geometry"/></mxCell><mxCell id="c6" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Examples&lt;/span&gt;&lt;br&gt;Claude, GPT, Gemini' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="500" height="62" as="geometry"/></mxCell><mxCell id="c7" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Examples&lt;/span&gt;&lt;br&gt;Llama, Gemma, Qwen, Mistral, DeepSeek' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="212" width="500" height="62" as="geometry"/></mxCell><mxCell id="c8" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Strengths&lt;/span&gt;&lt;br&gt;Most capable; nothing to host;&lt;br&gt;new versions automatically' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="500" height="62" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Strengths&lt;/span&gt;&lt;br&gt;Data stays with you; no per-token bill;&lt;br&gt;can fine-tune and run offline' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="284" width="500" height="62" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Trade-offs&lt;/span&gt;&lt;br&gt;Per-token cost; data leaves your network;&lt;br&gt;model can change or be retired' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="500" height="62" as="geometry"/></mxCell><mxCell id="c11" value='&lt;span style="color:#4A5568;font-size:12px"&gt;Trade-offs&lt;/span&gt;&lt;br&gt;You run the hardware; smaller ones are&lt;br&gt;less capable; you handle updates' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="356" width="500" height="62" as="geometry"/></mxCell><mxCell id="c12" value="“Open-weight” ≠ fully open source: you get the weights, usually not the training data. Licences vary, so read them." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1040" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep06-2" name="2 · Families and tiers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="520" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Every family comes in sizes: pick the tier, not just the brand" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Largest: smartest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="270" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Balanced: the default" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="270" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Smallest: fast and cheap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="270" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Anthropic · Claude&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fillColor=#F5F2EA;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="200" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Opus&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="134" width="270" height="62" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Sonnet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="134" width="270" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Haiku&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCEBDD;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="134" width="270" height="62" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Google · Gemini&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fillColor=#F5F2EA;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="200" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Pro&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="208" width="270" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Flash&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="208" width="270" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Flash-Lite&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCEBDD;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="208" width="270" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OpenAI · GPT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fillColor=#F5F2EA;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="200" height="62" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;flagship&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="282" width="270" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;mini&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="282" width="270" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;nano&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCEBDD;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="282" width="270" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Open-weight families&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fillColor=#F5F2EA;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="200" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;~70B–400B+&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="356" width="270" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;~8B–30B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="550" y="356" width="270" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;~1B–4B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FCEBDD;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="840" y="356" width="270" height="62" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="445" as="sourcePoint"/><mxPoint x="1090" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="smarter · slower · pricier" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=13;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="260" y="452" width="380" height="22" as="geometry"/></mxCell><mxCell id="c23" value="faster · cheaper · good enough for many jobs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=right;fontSize=13;fontColor=#A4500C;" vertex="1" parent="1"><mxGeometry x="710" y="452" width="380" height="22" as="geometry"/></mxCell><mxCell id="c24" value="Names and version numbers change every few months; the tiers stay. Open-weight examples: Llama, Gemma, Qwen, Mistral, DeepSeek." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="1080" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep06-3" name="3 · Where models run"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Three ways to run a model" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-size:16px"&gt;Provider API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Anthropic, OpenAI,&lt;br&gt;Google AI Studio&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="340" height="80" as="geometry"/></mxCell><mxCell id="c3" value="• Fastest way to start&lt;br&gt;• Newest models first&lt;br&gt;• Data goes to the provider" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="340" height="120" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:16px"&gt;Cloud platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Amazon Bedrock, Google Vertex AI,&lt;br&gt;Azure AI Foundry&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="340" height="80" as="geometry"/></mxCell><mxCell id="c5" value="• Many models, one bill&lt;br&gt;• Your cloud's IAM, regions, networking&lt;br&gt;• What most enterprises use" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="172" width="340" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:16px"&gt;Self-host&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Ollama on a laptop,&lt;br&gt;vLLM on GPU servers&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="340" height="80" as="geometry"/></mxCell><mxCell id="c7" value="• Open-weight models only&lt;br&gt;• Full control and privacy&lt;br&gt;• You run and pay for hardware" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="172" width="340" height="120" as="geometry"/></mxCell><mxCell id="c8" value="Same model, different doors: Claude, for example, is available from Anthropic's API, Amazon Bedrock and Google Vertex AI. Module 10 deploys on Bedrock." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1080" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep06-4" name="4 · Choosing a model"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="How to choose a model for a use case" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Define the job&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;task, inputs, quality bar&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Must data stay&lt;br&gt;in-house?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="210" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Open-weight&lt;/b&gt;, self-hosted&lt;br&gt;or private cloud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;fillColor=#FCEBDD;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="210" height="70" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Build a test set&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;20–50 real examples&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="210" height="70" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Try the smallest tier&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;measure quality, cost, speed&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Passes your&lt;br&gt;tests?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="845" y="220" width="210" height="110" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Ship it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;keep it swappable&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Step up one tier&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;or improve the prompt&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="210" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="yes" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="no" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="265"/><mxPoint x="540" y="200"/><mxPoint x="612" y="200"/></Array></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="yes" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="no" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="738" y="200"/><mxPoint x="884" y="200"/></Array></mxGeometry></mxCell><mxCell id="c19" value="Also check: context window, modalities (images, audio), tool calling, rate limits and licence. Re-test when a new model comes out." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1080" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>