<mxfile host="genai-zero-to-production" type="device"><diagram id="ep08-1" name="1 · The six parts of a prompt"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The anatomy of a prompt: six parts" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-size:16px"&gt;Role&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#D8E4F8;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Who the model is" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="80" width="230" height="60" as="geometry"/></mxCell><mxCell id="c4" value='&lt;span style="font-family:Courier New;font-size:12px"&gt;You are a support agent for Pageturn, an online bookshop.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="620" height="60" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:16px"&gt;Context&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EEDDF0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="What it needs to know" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="152" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;Returns policy… + the customer's message in &amp;lt;message&amp;gt; tags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="152" width="620" height="60" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:16px"&gt;Task&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F5E7B5;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="200" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Exactly what to do" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="224" width="230" height="60" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="font-family:Courier New;font-size:12px"&gt;Write a reply to the customer.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="224" width="620" height="60" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:16px"&gt;Constraints&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="200" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Rules and limits" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="296" width="230" height="60" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-family:Courier New;font-size:12px"&gt;Under 60 words · always ask for the order number · no discounts&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="296" width="620" height="60" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:16px"&gt;Examples&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="200" height="60" as="geometry"/></mxCell><mxCell id="c15" value="What good looks like" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="368" width="230" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;{&quot;reply&quot;: &quot;I'm sorry your mug arrived chipped!…&quot;, &quot;action&quot;: …}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="368" width="620" height="60" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b style="font-size:16px"&gt;Output format&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3E0D9;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="200" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Shape of the answer" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="440" width="230" height="60" as="geometry"/></mxCell><mxCell id="c19" value='&lt;span style="font-family:Courier New;font-size:12px"&gt;Only JSON with keys "reply", "action", "needs_order_number"&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="620" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Not every prompt needs all six, but when output goes wrong, the fix is usually a missing or unclear part." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1080" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep08-2" name="2 · What each part fixed"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Building the prompt one part at a time: pass rates over 10 runs" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;≤ 60 words&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="192" height="34" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;asks for order no.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="192" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;follows policy&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="192" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;valid JSON&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="192" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1 · vague&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="250" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;8/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#F5E7B5;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="124" width="192" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="124" width="192" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="7