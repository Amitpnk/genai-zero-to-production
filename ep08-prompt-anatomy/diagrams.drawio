Cell id="c17" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="236" width="192" height="48" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="236" width="192" height="48" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="236" width="192" height="48" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;0/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#FDECEC;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="236" width="192" height="48" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;4 · + example&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="250" height="48" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="292" width="192" height="48" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="292" width="192" height="48" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="292" width="192" height="48" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;5/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#F5E7B5;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="292" width="192" height="48" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;5 · + terse format spec&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;fontColor=#A4500C;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="250" height="48" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="348" width="192" height="48" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="348" width="192" height="48" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="348" width="192" height="48" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;0/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#FDECEC;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="348" width="192" height="48" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;6 · format, rewritten&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=14;fontColor=#A4500C;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="250" height="48" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="404" width="192" height="48" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="404" width="192" height="48" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="404" width="192" height="48" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;10/10&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;fillColor=#CFE7C8;strokeColor=none;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="404" width="192" height="48" as="geometry"/></mxCell><mxCell id="c36" value="Real results from build_a_prompt.py (gemma3:1b, local). Adding context made replies far too long until constraints fixed it. A terse format spec made JSON &lt;b&gt;worse&lt;/b&gt; (0/10); rewriting it clearly gave 10/10 on every check. &lt;b&gt;Test every change.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1080" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep08-3" name="3 · Where each part goes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="420" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Stable parts in the system prompt, changing parts in the user message" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value="System prompt: same every request" style="rounded=1;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="520" height="46" as="geometry"/></mxCell><mxCell id="c3" value="User message: changes every request" style="rounded=1;html=1;fillColor=#A4500C;strokeColor=#A4500C;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="520" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Role&lt;/b&gt;: who the model is" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#D8E4F8;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="520" height="46" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Constraints&lt;/b&gt;: rules and limits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="520" height="46" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Examples&lt;/b&gt;: what good looks like" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="520" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Output format&lt;/b&gt;: shape of the answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3E0D9;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="520" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Context&lt;/b&gt;: what it needs to know" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EEDDF0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="520" height="46" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Task&lt;/b&gt;: exactly what to do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F5E7B5;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="196" width="520" height="46" as="geometry"/></mxCell><mxCell id="c10" value="Wrap untrusted input (the customer's message, a document) in tags like &lt;span style=&quot;font-family:Courier New&quot;&gt;&amp;lt;message&amp;gt;&lt;/span&gt;, so the model treats it as data, not instructions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;align=left;spacingLeft=16;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="520" height="90" as="geometry"/></mxCell><mxCell id="c11" value="A stable system prompt is also cheaper with prompt caching (Module 10)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="1080" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep08-4" name="4 · Prompt iteration loop"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Prompt engineering is a loop, not a one-shot" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Write&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;a first version&lt;br&gt;with all six parts&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Test&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;on 10–50 real examples&lt;br&gt;with automatic checks&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2994A;strokeColor=#F2994A;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Read failures&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;which check fails,&lt;br&gt;and why?&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Change one thing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;a single part&lt;br&gt;at a time&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=14;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#4A5568;strokeWidth=1.5;fontColor=#4A5568;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="re-test" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A4500C;strokeWidth=2;dashed=1;fontColor=#A4500C;fontStyle=1;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="270"/><mxPoint x="435" y="270"/></Array></mxGeometry></mxCell><mxCell id="c10" value="Change one part at a time so you know what helped. In this episode, one change made things worse (the terse format spec); only the test caught it. Proper evals come in Module 9." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1080" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>