<mxfile host="genai-zero-to-production" type="device"><diagram id="ep04-1" name="1 · Context window budget"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="330" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Everything in one request has to fit in the context window" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;System prompt&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E4F8;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="120" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Tool definitions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEDDF0;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="160" y="120" width="130" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Chat history&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5E7B5;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="250" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Retrieved documents&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEBD3;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="250" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Your question&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DCC0;strokeColor=#C4C1BB;fontColor=#0