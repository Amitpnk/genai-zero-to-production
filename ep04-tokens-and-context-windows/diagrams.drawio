olor=#0E1726;fontFamily=Helvetica;align=left;fontSize=12;fontColor=#A4500C;" vertex="1" parent="1"><mxGeometry x="550" y="282" width="450" height="22" as="geometry"/></mxCell><mxCell id="c30" value="Model answered “Note 51” instead of BLUE-TIGER-42. No error, just a wrong answer." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0E1726;fontFamily=Helvetica;align=left;fontSize=13;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="550" y="310" width="450" height="40" as="geometry"/></mxCell><mxCell id="c31" value="Real output from context_overflow.py with gemma3:1b." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="980" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ep04-4" name="4 · Where the time goes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="330" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Where the waiting time goes" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0E1726;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Read the input&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;all prompt tokens at once (fast)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E4F8;strokeColor=#C4C1BB;fontColor=#0E1726;fontSize=13;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="70" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Thinking&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;hidden reasoning tokens (optional)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;htm